# Copy to .env for local dev (used by `vercel dev`), or — for production —
# set these in Vercel → Settings → Environment Variables, then redeploy.
#
# VITE_* values are baked in at BUILD time (redeploy after changing them).
# All other values are read at RUNTIME by serverless functions in api/.

# --- Frontend (build-time, safe to expose) ---
VITE_CONTACT_EMAIL=north-star-pacific@pantopus.com
VITE_BOOKING_URL=
VITE_PAYMENT_LINK=
# VITE_AUDIT_PRICE="$2,500"   # optional; defaults to $2,500 in src/config.ts
# Keep VITE_PAYMENT_LINK empty until a fixed-scope AI Opportunity Audit SKU is ready.

# --- Lead form (api/lead.ts) ---
RESEND_API_KEY=
LEAD_TO_EMAIL=north-star-pacific@pantopus.com
LEAD_FROM_EMAIL=North Star Pacific <north-star-pacific@pantopus.com>

# --- AI Opportunity Scan (api/scan/*) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FROM_EMAIL=North Star Pacific <north-star-pacific@pantopus.com>
CALENDLY_URL=https://calendly.com/your-link/ai-opportunity-audit
# Public site origin for report links in email (production custom domain).
SITE_URL=https://north-star-pacific.vercel.app
